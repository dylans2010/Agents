  "notes": {
    "authority": "Agents/Resources/ProfileDenyLists.json is the single source of truth for the read-only and approval-required deny lists. Rust profile_gate.rs keeps its const arrays as the runtime enforcement authority and a test pins them to this file; Swift SystemToolRegistry loads this file from the app bundle at runtime and keeps no hand-maintained copy. A change to either deny list starts here.",
    "rule": "Union of the two sides: the stricter side wins. A tool denied by either side is denied in the unified set. No genuine platform or side difference was found among the 20 differing tools, so none was kept as a divergence.",
    "nonSubset": "Approval-required is not a subset of read-only by design: 28 tools are denied for approval-required but allowed for read-only. They are pure readers that execute through the terminal (binary_size_report, device_list, simulator_list, test_coverage_report, xcode_scheme_manager, and the rest); read-only allows the read, approval-required denies the terminal execution.",
    "reconciliation": [
      {
        "tool": "dead_code_eliminator",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Report-only by description (workspace.read_file, deletes nothing), but the name promises deletion and Rust denied it; the union rule denies it, so a read-only preset never presents a deletion-named tool."
      },
      {
        "tool": "entitlements_manager",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Adds or removes entitlements in .entitlements plists (workspace.write_file)."
      },
      {
        "tool": "env_capture_logs",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Captures a memory snapshot and stores it as a memory entry (memory.snapshot), despite the log-flavored name."
      },
      {
        "tool": "execution_plan",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Writes the plan to agent_notes.md in the working directory."
      },
      {
        "tool": "intel_breakdown_task",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Expands a stored plan into granular sub-steps; mutates stored plan state."
      },
      {
        "tool": "intel_plan_task",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Drafts a plan as worker steps and stores it; later steps take its planId."
      },
      {
        "tool": "json_to_plist",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Converts a JSON file into a plist file (workspace.write_file); Swift denied json_to_csv and plist_to_json but missed this one."
      },
      {
        "tool": "mem_context_snapshot",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Mints a new snapshot key and stores it as a memory entry."
      },
      {
        "tool": "project_capabilities",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Enables or disables Xcode capabilities backed by boolean entitlements (workspace.write_file)."
      },
      {
        "tool": "project_info_plist",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Gets, sets, or deletes Info.plist keys (workspace.write_file)."
      },
      {
        "tool": "read_terminal",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Reads a terminal viewport snapshot. Terminal I/O is a unit with create_terminal, which is denied for read-only, so no terminal exists to read in a read-only thread; Rust denies the terminal surface for read-only."
      },
      {
        "tool": "system_notification_tool",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Posts a macOS user notification; a side effect outside the workspace."
      },
      {
        "tool": "use_mcp",
        "before": "rust-only",
        "final": "denied for read-only",
        "reason": "Runs an MCP tool by name, so it can reach mutating tools behind the MCP server."
      },
      {
        "tool": "github_repo",
        "before": "swift-only",
        "final": "denied for read-only and approval-required",
        "reason": "fetch_repository downloads a repo tarball and writes it into the workspace (gh api tarball redirected to a file); the tool is not read-only."
      },
      {
        "tool": "zoom",
        "before": "swift-only",
        "final": "denied for read-only",
        "reason": "Handler evidence is read-only (a sharper image of a region of the observed window; zoom only reads the observed window), but Swift denied it and no platform or side difference exists, so the stricter side wins under the union rule. Relaxing it is a one-line manifest change."
      },
      {
        "tool": "git_conflict_resolver",
        "before": "rust-only",
        "final": "denied for approval-required",
        "reason": "Resolve mode edits a file with the ours, theirs, or both strategy; Swift's git-mutating set missed it because detect mode only reads."
      },
      {
        "tool": "manage_memory",
        "before": "rust-only",
        "final": "denied for approval-required",
        "reason": "Stores, edits, appends, deletes, or clears entries in the SQLite agent memory store."
      },
      {
        "tool": "project_restore",
        "before": "rust-only",
        "final": "denied for approval-required",
        "reason": "Hard-resets the workspace to a snapshot and removes untracked and ignored files."
      },
      {
        "tool": "project_snapshot",
        "before": "rust-only",
        "final": "denied for approval-required",
        "reason": "Creates checkpoint commits (git.checkpoints.create); mutates git state."
      },
      {
        "tool": "safe_undo",
        "before": "rust-only",
        "final": "denied for approval-required",
        "reason": "Restores the second-newest snapshot; discards uncommitted and untracked changes."
      }
    ]
  }
}
